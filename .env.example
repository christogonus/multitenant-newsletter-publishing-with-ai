APP_NAME="NewsPub AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ANTHROPIC_API_KEY=
NEWSPUB_AI_PROVIDER=anthropic
NEWSPUB_AI_MODEL=
NEWSPUB_PUBLIC_ROOT=
NEWSPUB_SUPPORT_EMAIL=support@example.com

WARRIORPLUS_SECURITY_KEY=
WP_PRODUCT_FRONT_END=
WP_PRODUCT_BUMP_VAULT=
WP_PRODUCT_OTO1_LITE=
WP_PRODUCT_OTO1_PRO=
WP_PRODUCT_OTO2_UNLIMITED=
WP_PRODUCT_OTO3_GROWTH=
WP_PRODUCT_OTO4_SPONSOR=
WP_PRODUCT_OTO5_DFY=
WP_PRODUCT_OTO6_SOCIAL=
WP_PRODUCT_OTO7_AUTOPILOT=
WP_PRODUCT_OTO8_PREMIUM=
WP_PRODUCT_OTO9_MULTI=
WP_PRODUCT_OTO10_NETWORK=
WP_PRODUCT_OTO11_AGENCY=
WP_PRODUCT_OTO12_RESELLER=
CHECKOUT_FRONT_END=
CHECKOUT_BUMP_VAULT=
CHECKOUT_OTO1_LITE=
CHECKOUT_OTO1_PRO=
CHECKOUT_OTO2_UNLIMITED=
CHECKOUT_OTO3_GROWTH=
CHECKOUT_OTO4_SPONSOR=
CHECKOUT_OTO5_DFY=
CHECKOUT_OTO6_SOCIAL=
CHECKOUT_OTO7_AUTOPILOT=
CHECKOUT_OTO8_PREMIUM=
CHECKOUT_OTO9_MULTI=
CHECKOUT_OTO10_NETWORK=
CHECKOUT_OTO11_AGENCY=
CHECKOUT_OTO12_RESELLER=

# Where Horizon long-wait alerts are emailed.
NEWSPUB_ALERT_EMAIL=
NEWSPUB_AI_DAILY_SPEND_ALERT=50
# Deterministic writer for demos and browser tests. Ignored when APP_ENV=production.
NEWSPUB_AI_FAKE=false

# Production queues run on Redis with Horizon (QUEUE_CONNECTION=redis).
# Jobs can run for up to 300 seconds, so keep retry_after above the Horizon timeout.
DB_QUEUE_RETRY_AFTER=400
REDIS_QUEUE_RETRY_AFTER=400
PULSE_ENABLED=true

# Custom domain certificates (OTO 8): "ploi" adds each verified domain as a Ploi tenant and requests
# its certificate; "external" leaves certificates to the web server (Caddy on-demand TLS) or none locally.
NEWSPUB_CERTIFICATES=external
PLOI_API_TOKEN=
PLOI_SERVER_ID=
PLOI_SITE_ID=
# Public IP of the web server. Owners of bare domains (theirsite.com) point an A record here.
NEWSPUB_SERVER_IP=
